<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agentcore</groupId>
    <artifactId>agentcore-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>agentcore-bootstrap</artifactId>
  <description>独立部署版：基于 Spring Boot 的命令行与 HTTP 服务（bin/agentcore），组装交给 starter 的自动装配</description>
  <dependencies>
    <dependency><groupId>com.agentcore</groupId><artifactId>agentcore-spring-boot-starter</artifactId></dependency>
    <!-- serve 命令的 Web 服务 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>
    <!-- 配置了 spring.datasource.url 时把会话和记忆存进数据库；JDBC 驱动通过 AGENTCORE_CLASSPATH 加入 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><version>${h2.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <finalName>agentcore</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>com.agentcore.bootstrap.AgentCoreApplication</mainClass>
          <!-- ZIP 布局使用 PropertiesLauncher：可以用 -Dloader.path 追加外部 jar（例如 JDBC 驱动） -->
          <layout>ZIP</layout>
        </configuration>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
