y"/></mxCell><mxCell id="overview-v48" value="外部系统" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1390" y="450" width="370" height="32" as="geometry"/></mxCell><mxCell id="overview-e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1395" y="505" as="sourcePoint"/><mxPoint x="1475" y="505" as="targetPoint"/></mxGeometry></mxCell><mxCell id="overview-v50" value="调用 / 使用" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1485" y="495" width="270" height="20" as="geometry"/></mxCell><mxCell id="overview-e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1395" y="535" as="sourcePoint"/><mxPoint x="1475" y="535" as="targetPoint"/></mxGeometry></mxCell><mxCell id="overview-v52" value="实现端口（虚线）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1485" y="525" width="270" height="20" as="geometry"/></mxCell><mxCell id="overview-v53" value="&lt;b&gt;模块依赖方向&lt;/b&gt;（Maven 强制）&lt;br&gt;domain ← application ← interfaces&lt;br&gt;　　← spring-boot-starter ← bootstrap&lt;br&gt;domain ← infrastructure&lt;br&gt;&lt;br&gt;领域层 import Spring / Jackson / JDBC&lt;br&gt;会直接编译失败" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#fffcf0;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1390" y="570" width="370" height="150" as="geometry"/></mxCell><mxCell id="overview-v54" value="&lt;b&gt;几个关键设计&lt;/b&gt;&lt;br&gt;• 历史只追加，原样回放给同一厂商&lt;br&gt;• 工具调用一一回复，历史永远合法&lt;br&gt;• 事件即存储：文件一行 / 表一行&lt;br&gt;• 错误交还给模型自己修正&lt;br&gt;• 引擎无状态，过程全部是 AgentEvent&lt;br&gt;• 一套组装、一套配置、一套接口" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#fafafa;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1390" y="740" width="370" height="170" as="geometry"/></mxCell><mxCell id="overview-e55" value="运行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.248;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="overview-v3" target="overview-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="overview-e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.354;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="overview-v4" target="overview-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="overview-e57" value="引入 starter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.429;exitY=1;exitDx=0;exitDy=0;entryX=0.654;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="overview-v5" target="overview-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="overview-e58" value="组装" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=