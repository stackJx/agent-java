parent="1"><mxGeometry x="200" y="670" width="380" height="46" as="geometry"/></mxCell><mxCell id="loop-v11" value="⑧ 模型&lt;br&gt;拒答了？" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="746" width="240" height="70" as="geometry"/></mxCell><mxCell id="loop-v12" value="有工具调用？" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="846" width="240" height="70" as="geometry"/></mxCell><mxCell id="loop-v13" value="输出被截断？" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="946" width="240" height="70" as="geometry"/></mxCell><mxCell id="loop-v14" value="⑨ 执行工具（右侧 9 道关卡，只读工具并行）&lt;br&gt;结果 + 运行中的插话 → 一条用户消息" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="1046" width="380" height="56" as="geometry"/></mxCell><mxCell id="loop-v15" value="压缩：旧对话 → 交接摘要&lt;br&gt;摘要 + 最新输入 = 新上下文" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#fffcf0;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="403" width="300" height="60" as="geometry"/></mxCell><mxCell id="loop-v16" value="不执行！回填错误结果：&lt;br&gt;参数可能不完整，请分步重试" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#fffcf0;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="951" width="300" height="60" as="geometry"/></mxCell><mxCell id="loop-v17" value="输出被截断？" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="980" y="846" width="240" height="70" as="geometry"/></mxCell><mxCell id="loop-v18" value="⑩ 运行中&lt;br&gt;有插话？" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="980" y="946" width="240" height="70" as="geometry"/></mxCell><mxCell id="loop-v19" value="结束：CANCELLED&lt;br&gt;或 MAX_TURNS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1280" y="305" width="200" height="50" as="geometry"/></mxCell><mxCell id="loop-v20" value="结束：REFUSAL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1280" y="756" width="200" height="50" as="geometry"/></mxCell><mxCell id="loop-v21" value="结束：MAX_TOKENS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1280" y="856" width="200" height="50" as="geometry"/></mxCell><mxCell id="loop-v22" value="结束：END_TURN" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1280" y="956" width="200" height="50" as="geometry"/></mxCell><mxCell id="loop-v23" value="不管从哪个出口结束，都会发出 RunFinished 事件并返回 RunResult。&lt;br&gt;运行中被取消或出错时，先给没完成的工具调用补上结果，历史保持合法。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1260" y="1112" width="260" height="110" as="geometry"/></mxCell><mxCell id="loop-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColo