<mxfile host="app.diagrams.net" agent="agentcore docs generator" version="24.7.17"><diagram id="overview" name="1 系统总览"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1480" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="overview-v1" value="agentcore-java 系统总览" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1300" height="32" as="geometry"/></mxCell><mxCell id="overview-v2" value="Java 21 · DDD 分层 · Spring Boot 4　｜　硬规则只有一条：领域层只依赖 java.*；领域之外统一用 Spring" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1300" height="24" as="geometry"/></mxCell><mxCell id="overview-v3" value="&lt;b&gt;终端用户&lt;/b&gt;&lt;br&gt;bin/agentcore chat / run / sessions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="300" height="64" as="geometry"/></mxCell><mxCell id="overview-v4" value="&lt;b&gt;前端 / 其他语言的服务&lt;/b&gt;&lt;br&gt;HTTP + SSE（bin/agentcore serve）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="86" width="300" height="64" as="geometry"/></mxCell><mxCell id="overview-v5" value="&lt;b&gt;业务方的 Spring Boot 应用&lt;/b&gt;&lt;br&gt;引入 starter，写 @AgentTool / AgentHook Bean&lt;br&gt;示例：agentcore-spring-boot-sample" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="920" y="86" width="420" height="64" as="geometry"/></mxCell><mxCell id="overview-v6" value="入口与组装（Spring Boot）" style="swimlane;startSize=30;rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#f7f2f9;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1300" height="170" as="geometry"/></mxCell><mxCell id="overview-v7" value="&lt;b&gt;agentcore-bootstrap&lt;/b&gt;（独立部署版 bin/agentcore）&lt;br&gt;AgentCoreApplication：解析参数 → 启动 Spring 容器&lt;br&gt;命令：chat · run · serve · sessions · init&lt;br&gt;agentcore-cli.yml：依次导入用户的配置文件&lt;br&gt;启动脚本：解压 jar + CDS 类缓存，约 1.6 秒" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="overview-v6"><mxGeometry x="16" y="40" width="540" height="116" as="geometry"/></mxCell><mxCell id="overview-v8" value="&lt;b&gt;agentcore-spring-boot-starter&lt;/b&gt;（唯一的组装方式）&lt;br&gt;AgentCoreAutoConfiguration：模型 · 工具 · 仓储 · 权限 · 引擎&lt;br&gt;AgentCoreProperties：agentcore.* 配置&lt;br&gt;Jdbc 自动装配（spring.datasource）· Web 自动装配&lt;br&gt;AgentToolRegistrar：收集 @AgentTool / Tool / AgentHook Bean" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="overview-v6"><mxGeometry x="636" y="40" width="648" height="116" as="geometry"/></mxCell><mxCell id="overview-v9" value="接口层 · agentcore-interfaces" style="swimlane;startSize=30;rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f2f7fd;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1300" height="130" as="geometry"/></mxCell><mxCell id="overview-v10" value="&lt;b&gt;命令行 cli/&lt;/b&gt;&lt;br&gt;ChatRepl · ConsoleRenderer（正文 stdout）&lt;br&gt;ConsoleApprover · ConsolePrompter" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="overview-v9"><mxGeometry x="16" y="40" width="400" height="76" as="geometry"/></mxCell><mxCell id="overview-v11" value="&lt;b&gt;Web 接口 web/&lt;/b&gt;（Spring MVC 注解控制器）&lt;br&gt;AgentController：/api/agent/**，发消息返回 SSE&lt;br&gt;BearerTokenInterceptor：agentcore.web.token" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="overview-v9"><mxGeometry x="436" y="40" width="520" height="76" as="geometry"/></mxCell><mxCell id="overview-v12" value="独立部署版和嵌入业务系统时&lt;br&gt;用的是同一个控制器、&lt;br&gt;同一个 AgentService" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="overview-v9"><mxGeometry x="976" y="44" width="300" height="70" as="geometry"/></mxCell><mxCell id="overview-v13" value="应用层 · agentcore-application" style="swimlane;startSize=30;rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f3faf2;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1300" height="130" as="geometry"/></mxCell><mxCell id="overview-v14" value="&lt;b&gt;AgentService&lt;/b&gt;（用例）&lt;br&gt;开始会话 · 发消息（同步 / 异步）· 取消 · 插话 · 压缩&lt;br&gt;同一会话同一时刻只有一个运行" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="overview-v13"><mxGeometry x="16" y="40" width="420" height="76" as="geometry"/></mxCell><mxCell id="overview-v15" value="&lt;b&gt;AsyncApprover&lt;/b&gt;&lt;br&gt;推送 approval_required&lt;br&gt;等前端回传，超时拒绝" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="overview-v13"><mxGeometry x="452" y="40" width="262" height="76" as="geometry"/></mxCell><mxCell id="overview-v16" value="&lt;b&gt;SystemPromptBuilder&lt;/b&gt;&lt;br&gt;人设 + 环境 + AGENTS.md&lt;br&gt;+ 记忆索引 + 技能列表" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="overview-v13"><mxGeometry x="730" y="40" width="270" height="76" as="geometry"/></mxCell><mxCell id="overview-v17" value="&lt;b&gt;TaskTool&lt;/b&gt;（子 Agent，也是一个 Tool）&lt;br&gt;独立上下文，可并行&lt;br&gt;MemoryTools · SkillTool" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="overview-v13"><mxGeometry x="1016" y="40" width="268" height="76" as="geometry"/></mxCell><mxCell id="overview-v18" value="领域层 · agentcore-domain（只依赖 java.*）" style="swimlane;startSize=30;rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#fffcf0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1300" height="300" as="geometry"/></mxCell><mxCell id="overview-v19" value="&lt;b&gt;AgentEngine&lt;/b&gt;（领域服务 · 主循环）&lt;br&gt;调模型 → 执行工具 → 再调模型&lt;br&gt;退避重试 · 只读工具并行&lt;br&gt;取消 · 插话 · 超窗压缩" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="overview-v18"><mxGeometry x="16" y="40" width="330" height="100" as="geometry"/></mxCell><mxCell id="overview-v20" value="&lt;b&gt;Conversation&lt;/b&gt;（聚合根）&lt;br&gt;历史只追加，压缩是唯一的整体替换&lt;br&gt;工具调用必须一一回复&lt;br&gt;每次变化产生领域事件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="overview-v18"><mxGeometry x="370" y="40" width="290" height="100" as="geometry"/></mxCell><mxCell id="overview-v21" value="&lt;b&gt;PermissionPolicy&lt;/b&gt;&lt;br&gt;deny &amp;gt; ask &amp;gt; allow&lt;br&gt;&amp;gt; 模式默认值&lt;br&gt;bash 拆成子命令检查" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="overview-v18"><mxGeometry x="684" y="40" width="196" height="100" as="geometry"/></mxCell><mxCell id="overview-v22" value="&lt;b&gt;ConversationCompactor&lt;/b&gt;&lt;br&gt;旧对话 → 交接摘要&lt;br&gt;摘要 + 最新输入&lt;br&gt;= 新的上下文" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="overview-v18"><mxGeometry x="904" y="40" width="180" height="100" as="geometry"/></mxCell><mxCell id="overview-v23" value="&lt;b&gt;AgentHook&lt;/b&gt;&lt;br&gt;模型 / 工具前后插规则&lt;br&gt;&lt;b&gt;AgentEvent&lt;/b&gt;&lt;br&gt;对外发出的全部事件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="overview-v18"><mxGeometry x="1108" y="40" width="176" height="100" as="geometry"/></mxCell><mxCell id="overview-v24" value="&lt;b&gt;端口&lt;/b&gt;（橙色六边形）：领域层定义的接口&lt;br&gt;AgentEngine 只通过它们使用模型、存储、审批和工具" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="overview-v18"><mxGeometry x="904" y="144" width="380" height="40" as="geometry"/></mxCell><mxCell id="overview-v25" value="&lt;b&gt;ModelGateway&lt;/b&gt;&lt;br&gt;和大模型对话" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="overview-v18"><mxGeometry x="16" y="186" width="200" height="80" as="geometry"/></mxCell><mxCell id="overview-v26" value="&lt;b&gt;ConversationRepository&lt;/b&gt;&lt;br&gt;保存 / 读取会话事件" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="overview-v18"><mxGeometry x="232" y="186" width="230" height="80" as="geometry"/></mxCell><mxCell id="overview-v27" value="&lt;b&gt;MemoryRepository&lt;/b&gt;&lt;br&gt;&lt;b&gt;SkillCatalog&lt;/b&gt;&lt;br&gt;长期记忆 · 技能" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="overview-v18"><mxGeometry x="478" y="186" width="230" height="80" as="geometry"/></mxCell><mxCell id="overview-v28" value="&lt;b&gt;Approver&lt;/b&gt;&lt;br&gt;谁来批准" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="overview-v18"><mxGeometry x="724" y="186" width="170" height="80" as="geometry"/></mxCell><mxCell id="overview-v29" value="&lt;b&gt;Tool&lt;/b&gt; / ToolRegistry&lt;br&gt;模型能调用的能力" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="overview-v18"><mxGeometry x="910" y="186" width="200" height="80" as="geometry"/></mxCell><mxCell id="overview-v30" value="&lt;b&gt;UserPrompter&lt;/b&gt;&lt;br&gt;向用户提问" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="overview-v18"><mxGeometry x="1126" y="186" width="158" height="80" as="geometry"/></mxCell><mxCell id="overview-v31" value="基础设施层 · agentcore-infrastructure（端口的具体实现）" style="swimlane;startSize=30;rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#fdf3f3;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1300" height="220" as="geometry"/></mxCell><mxCell id="overview-v32" value="&lt;b&gt;llm/ 模型适配&lt;/b&gt;&lt;br&gt;AnthropicModelGateway（官方 SDK）&lt;br&gt;OpenAiResponsesModelGateway（/responses）&lt;br&gt;OpenAiCompatibleModelGateway&lt;br&gt;（/chat/completions，DeepSeek 等）&lt;br&gt;ScriptedModelGateway（-m mock）&lt;br&gt;ModelGatewayFactory：provider:model" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="overview-v31"><mxGeometry x="16" y="40" width="330" height="166" as="geometry"/></mxCell><mxCell id="overview-v33" value="&lt;b&gt;persistence/ 存储&lt;/b&gt;&lt;br&gt;JsonlConversationRepository（默认）&lt;br&gt;InMemoryConversationRepository&lt;br&gt;FileMemoryRepository · FileSkillCatalog&lt;br&gt;jdbc/：JdbcConversationRepository&lt;br&gt;　　　JdbcMemoryRepository&lt;br&gt;json/：DomainCodec 领域事件 ↔ JSON" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="overview-v31"><mxGeometry x="362" y="40" width="330" height="166" as="geometry"/></mxCell><mxCell id="overview-v34" value="&lt;b&gt;mcp/ MCP 客户端&lt;/b&gt;&lt;br&gt;McpServerManager&lt;br&gt;McpClient（stdio / HTTP）&lt;br&gt;McpTool：mcp__服务器__工具" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="overview-v31"><mxGeometry x="708" y="40" width="250" height="166" as="geometry"/></mxCell><mxCell id="overview-v35" value="&lt;b&gt;tool/ 工具&lt;/b&gt;&lt;br&gt;内置：read_file · write_file · edit_file&lt;br&gt;glob · grep · bash · web_fetch&lt;br&gt;todo_write · ask_user&lt;br&gt;注解：@AgentTool → AnnotatedTools" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacin