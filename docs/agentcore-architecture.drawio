ize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="loop-v18" target="loop-v6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="1150"/><mxPoint x="140" y="1150"/><mxPoint x="140" y="330"/></Array></mxGeometry></mxCell><mxCell id="loop-v47" value="单个工具调用的 9 道关卡（Run#runTool）" style="swimlane;startSize=30;rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f3faf2;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1560" y="84" width="480" height="880" as="geometry"/></mxCell><mxCell id="loop-v48" value="1. 工具存在吗？" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="loop-v47"><mxGeometry x="20" y="44" width="440" height="58" as="geometry"/></mxCell><mxCell id="loop-v49" value="2. 参数是合法的 JSON 吗？" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="loop-v47"><mxGeometry x="20" y="130" width="440" height="58" as="geometry"/></mxCell><mxCell id="loop-v50" value="3. 符合 JSON Schema 吗？&lt;br&gt;（顺带温和转换类型，&amp;quot;3&amp;quot; → 3）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="loop-v47"><mxGeometry x="20" y="216" width="440" height="58" as="geometry"/></mxCell><mxCell id="loop-v51" value="4. 权限策略&lt;br&gt;deny &amp;gt; ask &amp;gt; allow &amp;gt; 模式默认值" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="loop-v47"><mxGeometry x="20" y="302" width="440" height="58" as="geometry"/></mxCell><mxCell id="loop-v52" value="5. 需要询问 → Approver 审批&lt;br&gt;（没有审批人时一律拒绝）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="loop-v47"><mxGeometry x="20" y="388" width="440" height="58" as="geometry"/></mxCell><mxCell id="loop-v53" value="6. beforeTool 钩子&lt;br&gt;放行 / 拦截 / 改写参数" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="loop-v47"><mxGeometry x="20" y="474" width="440" height="58" as="geometry"/></mxCell><mxCell id="loop-v54" value="7. 执行：虚拟线程&lt;br&gt;默认超时 10 分钟，可被取消" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="loop-v47"><mxGeometry x="20" y="560" width="440" height="58" as="geometry"/></mxCell><mxCell id="loop-v55" value="8. 输出太长 → 截掉中间&lt;br&gt;（默认保留 30000 字符）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="loop-v47"><mxGeometry x="20" y="646" width="440" height="58" as="geometry"/></mxCell><mxCell id="loop-v56" value="9. afterTool 钩子&lt;br&gt;脱敏、改写输出" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="loop-v47"><mxGeometry x="20" y="732" width="440" height="58" as="geometry"/></mxCell><mxCell id="loop-v57" value="ToolResult 回填到会话" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="loop-v47"><mxGeometry x="100" y="818" width="280" height="50" as="geometry"/></mxCell><mxCell id="loop-e58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop-v48" target="loop-v49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="loop-e59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop-v49" target="loop-v50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="loop-e60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop-v50" target="loop-v51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="loop-e61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop-v51" target="loop-v52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="loop-e62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop-v52" target="loop-v53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="loop-e63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop-v53" target="loop-v54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="loop-e64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop-v54" target="loop-v55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="loop-e65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop-v55" target="loop-v56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="loop-e66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop-v56" target="loop-v57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="loop-v67" value="&lt;b&gt;任何一关没通过&lt;/b&gt;：不抛异常，而是生成一个错误结果交还给模型，让它自己调整做法。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1560" y="978" width="480" height="46" as="geometry"/></mxCell><mxCell id="loop-v68" value="&lt;b&gt;批量规则&lt;/b&gt;：模型一次要求多个调用时，连续的只读工具分成一批并行（最多 8 个），其余按顺序执行；结果按调用顺序回填。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1560" y="1030" width="480" height="66" as="geometry"/></mxCell><mxCell id="loop-e69" value="每个工具调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="loop-v14" target="loop-v47"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="1074"/></Array></mxGeometry></mxCell><mxCell id="loop-v70" value="过程中的每一步都以 AgentEvent 发出（引擎从不直接打印）" style="swimlane;startSize=30;rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f2f7fd;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="1236" width="1480" height="150" as="geometry"/></mxCell><mxCell id="loop-v71" value="run_started · turn_started · text_delta · thinking_delta · tool_call_streaming&lt;br&gt;assistant_message · permission_decided · tool_started · tool_progress&lt;br&gt;tool_finished · compacted · retrying · notice · run_finished" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="loop-v70"><mxGeometry x="16" y="40" width="760" height="96" as="geometry"/></mxCell><mxCell id="loop-v72" value="&lt;b&gt;命令行&lt;/b&gt;&lt;br&gt;ConsoleRenderer 渲染" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="loop-v70"><mxGeometry x="830" y="40" width="196" height="96" as="geometry"/></mxCell><mxCell id="loop-v73" value="&lt;b&gt;HTTP&lt;/b&gt;&lt;br&gt;SSE，每个事件一帧" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="loop-v70"><mxGeometry x="1046" y="40" width="196" height="96" as="geometry"/></mxCell><mxCell id="loop-v74" value="&lt;b&gt;--events&lt;/b&gt;&lt;br&gt;一行一个 JSON" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="loop-v70"><mxGeometry x="1262" y="40" width="202" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="config" name="3 配置与存储"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="config-v1" value="配置、模型选择与数据存储" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1400" height="32" as="geometry"/></mxCell><mxCell id="config-v2" value="独立部署版（bin/agentcore）和嵌入 Spring Boot 应用使用同一套配置项：agentcore.* + spring.* + server.*" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1400" height="24" as="geometry"/></mxCell><mxCell id="config-v3" value="配置读取顺序（独立部署版，后者覆盖前者）" style="swimlane;startSize=30;rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#f7f2f9;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="1640" height="176" as="geometry"/></mxCell><mxCell id="config-v4" value="&lt;b&gt;内置默认&lt;/b&gt;&lt;br&gt;agentcore-cli.yml（jar 里）&lt;br&gt;日志 · 端口 · 导入链" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="config-v3"><mxGeometry x="16" y="40" width="240" height="84" as="geometry"/></mxCell><mxCell id="config-v5" value="&lt;b&gt;全局配置&lt;/b&gt;&lt;br&gt;~/.agentcore/config.yaml&lt;br&gt;（或 $AGENTCORE_HOME）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="config-v3"><mxGeometry x="288" y="40" width="240" height="84" as="geometry"/></mxCell><mxCell id="config-v6" value="&lt;b&gt;项目配置&lt;/b&gt;&lt;br&gt;&amp;lt;工作目录&amp;gt;/.agentcore/&lt;br&gt;config.yaml" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="config-v3"><mxGeometry x="560" y="40" width="240" height="84" as="geometry"/></mxCell><mxCell id="config-v7" value="&lt;b&gt;项目配置&lt;/b&gt;&lt;br&gt;&amp;lt;工作目录&amp;gt;/agentcore.yaml" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="config-v3"><mxGeometry x="832" y="40" width="240" height="84" as="geometry"/></mxCell><mxCell id="config-v8" value="&lt;b&gt;--config 文件&lt;/b&gt;&lt;br&gt;命令行指定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="config-v3"><mxGeometry x="1104" y="40" width="240" height="84" as="geometry"/></mxCell><mxCell id="config-v9" value="&lt;b&gt;命令行参数&lt;/b&gt;&lt;br&gt;-m · --yolo · --cwd&lt;br&gt;--任意配置项=值" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="config-v3"><mxGeometry x="1376" y="40" width="240" height="84" as="geometry"/></mxCell><mxCell id="config-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="config-v4" target="config-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="config-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="config-v5" target="config-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="config-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="config-v6" target="config-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="config-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="config-v7" target="config-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="config-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="config-v8" target="config-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="config-v15" value="格式就是 Spring Boot 的 application.yml。嵌入 Spring Boot 应用时直接写在应用自己的 application.yml 里。独立部署版不读当前目录的 application.yml，在别的 Spring 项目里运行也不会串配置。引用环境变量写 ${ENV} 或 ${ENV:默认值}。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="config-v3"><mxGeometry x="16" y="134" width="1600" height="30" as="geometry"/></mxCell><mxCell id="config-v16" value="模型与 API Key" style="swimlane;startSize=30;rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="1640" height="206" as="geometry"/></mxCell><mxCell id="config-v17" value="&lt;b&gt;选哪个模型&lt;/b&gt;&lt;br&gt;1. agentcore.model 或 -m（provider:model）&lt;br&gt;2. 没写时按环境变量推断：&lt;br&gt;AGENTCORE_MODEL → ANTHROPIC_API_KEY&lt;br&gt;→ DEEPSEEK_API_KEY → OPENAI_API_KEY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="config-v16"><mxGeometry x="16" y="40" width="380" height="150" as="geometry"/></mxCell><mxCell id="config-v18" value="&lt;b&gt;按 type 选协议&lt;/b&gt;&lt;br&gt;anthropic → 官方 SDK&lt;br&gt;openai-responses → /responses&lt;br&gt;（provider 为 openai 时默认）&lt;br&gt;openai / openai-chat → /chat/completions&lt;br&gt;mock → 离线假模型" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="config-v16"><mxGeometry x="426" y="40" width="370" height="150" as="geometry"/></mxCell><mxCell id="config-v19" value="&lt;b&gt;读 API Key 的顺序&lt;/b&gt;&lt;br&gt;providers.&amp;lt;名字&amp;gt;.api-key → api-key-env 指定的环境变量 → 预设的环境变量 → OPENAI_API_KEY&lt;br&gt;预设：anthropic=ANTHROPIC_API_KEY · openai=OPENAI_API_KEY · deepseek=DEEPSEEK_API_KEY&lt;br&gt;qwen=DASHSCOPE_API_KEY · kimi=MOONSHOT_API_KEY · glm=ZHIPUAI_API_KEY&lt;br&gt;openrouter=OPENROUTER_API_KEY · ollama / vllm 不需要 Key&lt;br&gt;建议：Key 放在环境变量里，配置文件只写 ${ENV} 引用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="config-v16"><mxGeometry x="826" y="40" width="798" height="150" as="geometry"/></mxCell><mxCell id="config-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="config-v17" target="config-v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="config-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="config-v18" target="config-v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="config-v22" value="数据存在哪" style="swimlane;startSize=30;rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#fdf3f3;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="1640" height="330" as="geometry"/></mxCell><mxCell id="config-v23" value="&lt;b&gt;文件（默认）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="config-v22"><mxGeometry x="16" y="38" width="500" height="22" as="geometry"/></mxCell><mxCell id="config-v24" value="&lt;b&gt;会话&lt;/b&gt;　~/.agentcore/sessions/&amp;lt;会话ID&amp;gt;.jsonl&lt;br&gt;一行一个领域事件：started · msg · compacted · usage · meta" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="config-v22"><mxGeometry x="16" y="64" width="520" height="70" as="geometry"/></mxCell><mxCell id="config-v25" value="&lt;b&gt;长期记忆&lt;/b&gt;　~/.agentcore/memory/&amp;lt;名字&amp;gt;.md&lt;br&gt;带 frontmatter 的 Markdown，可以直接打开编辑" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="config-v22"><mxGeometry x="16" y="146" width="520" height="70" as="geometry"/></mxCell><mxCell id="config-v26" value="&lt;b&gt;技能&lt;/b&gt;　&amp;lt;工作目录&amp;gt;/.agentcore/skills/&amp;lt;名字&amp;gt;/SKILL.md&lt;br&gt;以及 ~/.agentcore/skills/（前者优先）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="config-v22"><mxGeometry x="16" y="228" width="520" height="70" as="geometry"/></mxCell><mxCell id="config-v27" value="&lt;b&gt;数据库&lt;/b&gt;（agentcore.persistence.jdbc.enabled=true + spring.datasource.url）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="config-v22"><mxGeometry x="570" y="38" width="1050" height="22" as="geometry"/></mxCell><mxCell id="config-v28" value="&lt;b&gt;agent_conversation&lt;/b&gt;（会话摘要）&lt;br&gt;id 主键 · title · metadata&lt;br&gt;message_count&lt;br&gt;last_seq：版本号，乐观并发&lt;br&gt;累计用量（tokens、请求数）&lt;br&gt;created_at · updated_at" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=top;spacingTop=10;" vertex="1" parent="config-v22"><mxGeometry x="570" y="64" width="320" height="150" as="geometry"/></mxCell><mxCell id="config-v29" value="&lt;b&gt;agent_conversation_event&lt;/b&gt;（领域事件）&lt;br&gt;conversation_id + seq 主键&lt;br&gt;event_type&lt;br&gt;payload：事件 JSON&lt;br&gt;created_at&lt;br&gt;按 seq 顺序读出 → 重放还原会话" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=top;spacingTop=10;" vertex="1" parent="config-v22"><mxGeometry x="940" y="64" width="320" height="150" as="geometry"/></mxCell><mxCell id="config-v30" value="&lt;b&gt;agent_memory&lt;/b&gt;（长期记忆）&lt;br&gt;scope_id + name 主键&lt;br&gt;description · memory_type&lt;br&gt;content · updated_at&lt;br&gt;按 scope 隔离（用户 / 租户）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=top;spacingTop=10;" vertex="1" parent="config-v22"><mxGeometry x="1304" y="64" width="320" height="150" as="geometry"/></mxCell><mxCell id="config-e31" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="config-v28" target="config-v29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="config-v32" value="&lt;b&gt;多个实例同时写同一个会话（乐观并发）&lt;/b&gt;&lt;br&gt;写入时在一个事务里：UPDATE agent_conversation … WHERE id = ? AND last_seq = 我读到的版本，再按 seq 追加事件。&lt;br&gt;更新了 0 行，说明别的实例先写了 → 抛 ConcurrencyConflictException，丢掉缓存，下次从数据库重新加载。&lt;br&gt;历史在库里共享，但正在运行的任务、审批、SSE 连接在某个实例的内存里，负载均衡要按会话 ID 粘性路由。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#fdf3f3;strokeColor=#b85450;" vertex="1" parent="config-v22"><mxGeometry x="570" y="228" width="1054" height="70" as="geometry"/></mxCell><mxCell id="config-v33" value="启动（bin/agentcore）" style="swimlane;startSize=30;rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f3faf2;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="868" width="1640" height="170" as="geometry"/></mxCell><mxCell id="config-v34" value="&lt;b&gt;bin/agentcore&lt;/b&gt;&lt;br&gt;没有 jar 时先 mvn install" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="config-v33"><mxGeometry x="16" y="40" width="290" height="110" as="geometry"/></mxCell><mxCell id="config-v35" value="&lt;b&gt;解压&lt;/b&gt;&lt;br&gt;agentcore.jar → target/agentcore-app/&lt;br&gt;jar 更新后自动重新解压" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="config-v33"><mxGeometry x="336" y="40" width="360" height="110" as="geometry"/></mxCell><mxCell id="config-v36" value="&lt;b&gt;CDS 类缓存&lt;/b&gt;&lt;br&gt;agentcore-app/agentcore.jsa&lt;br&gt;首次运行结束时生成，之后约 1.6 秒" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="config-v33"><mxGeometry x="726" y="40" width="360" height="110" as="geometry"/></mxCell><mxCell id="config-v37" value="&lt;b&gt;java -cp … AgentCoreApplication&lt;/b&gt;&lt;br&gt;命令行命令只用 C1 编译器；serve 保留完整 JIT&lt;br&gt;AGENTCORE_CLASSPATH 追加 JDBC 驱动 · AGENTCORE_CDS=0 关闭缓存" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="config-v33"><mxGeometry x="1116" y="40" width="508" height="110" as="geometry"/></mxCell><mxCell id="config-e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="config-v34" target="config-v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="config-e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="config-v35" target="config-v36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="config-e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="config-v36" target="config-v37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
