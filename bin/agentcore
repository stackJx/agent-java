#!/usr/bin/env bash
# agentcore 启动脚本：首次运行时自动构建可执行 jar。
# 额外的 jar（例如 JDBC 驱动）通过 AGENTCORE_CLASSPATH 追加，多个用冒号分隔：
#   AGENTCORE_CLASSPATH=/opt/drivers/mysql-connector-j.jar bin/agentcore
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
JAR="$ROOT/agentcore-bootstrap/target/agentcore.jar"
if [[ ! -f "$JAR" ]]; then
  echo "首次运行，正在构建 $JAR ..." >&2
  (cd "$ROOT" && mvn -q -DskipTests install) >&2
fi
exec java ${AGENTCORE_JAVA_OPTS:-} -cp "$JAR${AGENTCORE_CLASSPATH:+:$AGENTCORE_CLASSPATH}" com.agentcore.bootstrap.AgentCoreApplication "$@"
